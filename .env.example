# PCS 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ============================================================
# 数据库配置
# ============================================================

# 数据库引擎: sqlite / mysql / postgres
DB_ENGINE=sqlite

# MySQL/PostgreSQL 配置（当 DB_ENGINE 不为 sqlite 时生效）
# DB_NAME=pve_cluster_scan
# DB_USER=pcs
# DB_PASSWORD=your_password_here
# DB_HOST=127.0.0.1
# DB_PORT=3306

# SQLite 数据库路径（默认: db.sqlite3）
# DB_PATH=/path/to/db.sqlite3


# ============================================================
# LDAP 认证配置
# ============================================================

# 是否启用 LDAP 认证
LDAP_ENABLED=False

# LDAP 服务器地址
# LDAP_SERVER_URI=ldap://ldap.example.com:389

# LDAP 绑定 DN（用于搜索用户的管理员账号）
# LDAP_BIND_DN=cn=admin,dc=example,dc=com

# LDAP 绑定密码
# LDAP_BIND_PASSWORD=admin_password

# 用户搜索基础 DN
# LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com

# 用户搜索过滤器（%(user)s 会被替换为登录用户名）
# LDAP_USER_SEARCH_FILTER=(uid=%(user)s)

# 可选：组搜索基础 DN（用于权限控制）
# LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com


# ============================================================
# 其他配置
# ============================================================

# Django SECRET_KEY（生产环境务必修改）
# SECRET_KEY=your-secret-key-here

# 调试模式
# DEBUG=True

# 允许的主机
# ALLOWED_HOSTS=*
