# PCS Docker 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改
# 用法: docker compose --env-file .env up -d --build

# ============================================================
# 数据库配置
# ============================================================

# 数据库引擎: sqlite / mysql / postgres
DB_ENGINE=sqlite

# SQLite 数据库路径（默认: /app/data/db.sqlite3）
DB_PATH=/app/data/db.sqlite3

# MySQL/PostgreSQL 配置（当 DB_ENGINE 不为 sqlite 时生效）
# DB_NAME=pve_cluster_scan
# DB_USER=pcs
# DB_PASSWORD=your_password_here
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ============================================================
# 超级管理员配置
# ============================================================

SUPERUSER_USERNAME=pcs
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=your_secure_password_here

# ============================================================
# LDAP 认证配置（可选）
# ============================================================

# 是否启用 LDAP 认证
# 设置为 "True" 启用，"False" 或不设置则禁用
LDAP_ENABLED=False

# LDAP 服务器地址（启用 LDAP 时必须配置）
# LDAP_SERVER_URI=ldap://ldap.example.com:389

# LDAP 绑定 DN（用于搜索用户的管理员账号）
# LDAP_BIND_DN=cn=admin,dc=example,dc=com

# LDAP 绑定密码
# LDAP_BIND_PASSWORD=admin_password

# 用户搜索基础 DN
# LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com

# 用户搜索过滤器（%(user)s 会被替换为登录用户名）
# LDAP_USER_SEARCH_FILTER=(uid=%(user)s)

# ============================================================
# 其他配置
# ============================================================

# Python 配置
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================================
# LDAP 配置示例
# ============================================================

# 示例 1: OpenLDAP 标准配置
# LDAP_ENABLED=True
# LDAP_SERVER_URI=ldap://192.168.1.100:389
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=admin_password
# LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
# LDAP_USER_SEARCH_FILTER=(uid=%(user)s)

# 示例 2: Active Directory 配置
# LDAP_ENABLED=True
# LDAP_SERVER_URI=ldap://ad.company.com:389
# LDAP_BIND_DN=CN=pcs_service,OU=Service Accounts,DC=company,DC=com
# LDAP_BIND_PASSWORD=service_account_password
# LDAP_USER_SEARCH_BASE=OU=Users,DC=company,DC=com
# LDAP_USER_SEARCH_FILTER=(sAMAccountName=%(user)s)

# 示例 3: 使用 LDAPS（SSL 加密）
# LDAP_ENABLED=True
# LDAP_SERVER_URI=ldaps://ldap.example.com:636
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=admin_password
# LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
# LDAP_USER_SEARCH_FILTER=(uid=%(user)s)
